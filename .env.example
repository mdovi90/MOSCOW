# Supabase PostgreSQL connection string (prefer the session pooler for hosted Node services)
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
DATABASE_SSL=true

# Supabase project settings. Never put the service role key in browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=moscow-bakers

# Generate a long random value for production sessions.
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password
ADMIN_USERNAME=admin

# Optional comma-separated exact origins for a separate GitHub Pages customer site.
CUSTOMER_ORIGINS=https://your-account.github.io
NODE_ENV=development
